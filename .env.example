# Secret token gating the lead/host controls (/lead/<token>).
# If unset, a random token is generated on each start and printed to stdout.
RETRO_LEAD_TOKEN=dev-token

# HTTP port to bind.
PORT=5102

# Path to the SQLite database file. Created automatically on first run.
FASTRETRO_DB=data/fastretro.db

# Google OAuth client ID. Leave unset to disable Google Sign-In.
# See the "Google Sign-In" section of README.md for setup instructions.
GOOGLE_CLIENT_ID=

# Whether session cookies are marked Secure. Set to 0 for local HTTP testing.
COOKIE_SECURE=true

# tracing-subscriber env filter.
RUST_LOG=fast_retro=info,tower_http=info
