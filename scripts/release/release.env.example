# Host settings for the release scripts (scripts/release/*.sh, `make qa-deploy`
# and friends). Copy this to ~/.config/fast-retro/release.env, or anywhere
# else and point RELEASE_CONFIG at it, then fill it in. Keep your copy out of
# the repo.
#
# The scripts source this file as shell, so it runs with the deployer's
# permissions: keep it writable only by the account that deploys.
# Setup walkthrough: docs/RELEASING.md, "Setting up a deploy host".

# ---- required

# The GitHub repo whose CI builds you deploy, as <owner>/<repo>. Only builds
# attested by this repo's .github/workflows/build.yml are accepted, so set it
# to your own fork if you deploy from one.
REPO_SLUG=your-org/fast-retro

# Where builds, the prod/qa symlinks, QA's data and release.log live. Not a
# git repo; never committed. Created on first use.
RELEASE_ROOT=/srv/fast-retro-releases

# Public origins of the two environments, with no trailing slash. Verify
# checks each through your reverse proxy, including a WebSocket upgrade.
PROD_URL=https://retro.example.com
QA_URL=https://retro-qa.example.com

# Prod's SQLite file (the FASTRETRO_DB the prod service runs with). Restore
# points are written next to it.
PROD_DB=/srv/fast-retro/data/fastretro.db

# Directory supervisord writes each service's output to, as <service>.log
# (stdout) and <service>_err.log (stderr).
SERVICE_LOG_DIR=/var/log/fast-retro

# ---- optional (defaults shown)

# A git checkout of REPO_SLUG, used for `git fetch` and worktrees. Defaults to
# the checkout the scripts run from.
#FASTRETRO_REPO=/srv/fast-retro

# QA's own SQLite file.
#QA_DB=$RELEASE_ROOT/qa-data/fastretro-qa.db

# Ports the services listen on, and a free port for smoke tests.
#PROD_PORT=5102
#QA_PORT=5103
#SMOKE_PORT=5197

# supervisord program names.
#PROD_SERVICE=fast-retro-prod
#QA_SERVICE=fast-retro-qa

# supervisord config to pass as `supervisorctl -c`. Unset uses supervisorctl's
# own search path.
#SUPERVISOR_CONF=/etc/supervisor/supervisord.conf
